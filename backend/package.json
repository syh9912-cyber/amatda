{
  "name": "amatda-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "deploy": "npm run build && cd .. && npx firebase-tools deploy --only functions --project amatda-parenting",
    "seed:firestore": "ts-node prisma/seed-firestore.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@napi-rs/canvas": "^0.1.97",
    "@prisma/client": "^6.5.0",
    "@sentry/node": "^10.51.0",
    "@types/busboy": "^1.5.4",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.3",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "korean-lunar-calendar": "^0.3.6",
    "pdfkit": "^0.18.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "~19.2.10",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
