node_modules/
dist/
.env
.env.local
.env*.local
.env.backup*
*.env.backup*
*.db
*.db-journal
.expo/
ios/
android/
# 로컬 Expo 모듈의 android/ 폴더는 빌드에 필요 — 예외 처리
!frontend/modules/*/android/
!frontend/modules/*/android/**
*.tsbuildinfo
.turbo/
coverage/
*.log

# 민감정보 문서 — git에 절대 올리지 않음
LOCAL-CONFIG.md

# Release signing / OAuth / Firebase local secrets
*.jks
*.p8
*.p12
*.key
*.pem
*Secret*.txt
*secret*.txt
*키스토어*.txt
# Android google-services.json 은 Firebase 공식 가이드상 클라이언트 동봉 전제 파일
# (API 키는 식별자일 뿐 보안 경계 아님 — Firestore/Storage rules 가 진짜 보호막).
# .gitignore 와 추적 상태 불일치 정리: 의도적으로 추적한다.
# iOS GoogleService-Info.plist 는 EAS 빌드 시점 주입(EAS Secret) — 계속 ignore.
GoogleService-Info.plist
# Firebase Admin SDK service account (마이그레이션용 일회성 키)
service-account.json
backend/service-account.json
**/service-account*.json
**/firebase-adminsdk-*.json

# Google OAuth client credential dump (id-secret format)
[0-9]*-*.txt

# Claude Code internals
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.json

# Firebase emulator/cache
.firebase/

# 일회성 로그/임시 파일
lint_output.txt

# 에셋 백업 (커밋 X)
assets.backup/
frontend/assets.backup/

# 일회성 테스트 스크립트
test-milestone-*.cjs

# 마이그레이션 스크립트의 백업 데이터 (사용자 PII 포함 가능)
backend/scripts/migrate-album-photos/backup-*/
backend/scripts/**/backup-*/
